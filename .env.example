# The build reads this public key from its environment, not automatically from .env.
# Set it in the shell for local builds and in Netlify's build environment for deploys.
# Use the project's sb_publishable_ key, never an sb_secret_ or service_role key.
NVA_SUPABASE_PUBLISHABLE_KEY=

# The remaining variables are reserved for later server features. Do not place
# server secrets in browser scripts, HTML, or the Netlify publish directory.

# Full public origin; also restrict authentication callback destinations server-side.
APP_BASE_URL=

# Coach's actual IANA timezone (must be confirmed).
BUSINESS_TIMEZONE=

# Server-only database credential; select provider before configuring.
DATABASE_URL=

# Supabase Auth custom SMTP is configured in its dashboard, not in this file.

# Supabase receipt-worker function secrets (set in Supabase, never in Netlify's
# public build environment). Delivery remains disabled in the database until
# the sender and scheduled worker have been verified.
# RESEND_API_KEY=
# NVA_RECEIPT_FROM=receipts@your-verified-domain.example
# NVA_PUBLIC_ORIGIN=https://your-production-domain.example
